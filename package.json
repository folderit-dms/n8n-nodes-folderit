{
  "name": "n8n-nodes-folderit",
  "version": "0.4.0",
  "description": "n8n community node for Folderit document and folder management",
  "license": "MIT",
  "homepage": "https://www.folderit.com/",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Folderit",
    "url": "https://www.folderit.com/",
    "email": "kent@folderit.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/folderit-dms/n8n-nodes-folderit.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test tests/*.test.cjs"
  },
  "files": [
    "dist/nodes",
    "dist/credentials",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FolderitOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Folderit/Folderit.node.js",
      "dist/nodes/Folderit/FolderitTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.3",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
