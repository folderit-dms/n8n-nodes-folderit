{
  "name": "Folderit — Email attachment archive with durable receipts",
  "nodes": [
    {
      "id": "80496824-1baa-5330-84ab-6c03aea58e6e",
      "name": "New email with attachments",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "nothing",
        "downloadAttachments": true,
        "format": "simple",
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "trackLastMessageId": true
        }
      }
    },
    {
      "id": "aaff4754-021a-5747-b23b-725e44c7e6e7",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        400
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"accountUid\": \"YOUR_ACCOUNT_UID\",\n  \"folderUid\": \"YOUR_DESTINATION_FOLDER_UID\",\n  \"ledgerTableId\": \"YOUR_LEDGER_TABLE_ID\",\n  \"mailboxScope\": \"YOUR_STABLE_MAILBOX_LABEL\",\n  \"allowedExtensions\": \"pdf,docx,txt\"\n}",
        "options": {}
      }
    },
    {
      "id": "524f913d-0ae4-57db-a5b1-fbd9ca0008b6",
      "name": "Split and validate attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg=$('Settings').first().json;\nfor(const key of ['accountUid','folderUid','ledgerTableId','mailboxScope']) if(typeof cfg[key]!=='string'||!cfg[key].trim()||cfg[key].startsWith('YOUR_')) throw new Error(`Replace ${key} in Settings.`);\nconst allowed=String(cfg.allowedExtensions||'').split(',').map(x=>x.trim().toLowerCase().replace(/^\\./,'')).filter(Boolean);\nif(!allowed.length)throw new Error('Set allowedExtensions, for example pdf,docx,txt.');\nconst out=[]; const mail=$('New email with attachments').all();\nfor(let i=0;i<mail.length;i++){\n const source=mail[i].json;\n const messageId=[source.messageId,source.internetMessageId,source.metadata?.['message-id'],source.id].find(value=>typeof value==='string'&&value.trim())?.trim()||'';\n const parts=Object.entries(mail[i].binary||{}).filter(([k])=>k.startsWith('attachment_'));\n if(parts.length&&!messageId)throw new Error('Email has no stable Message-ID/provider ID. Inspect it before archiving.');\n for(const [field,b] of parts){\n  const fileName=String(b.fileName||'').split(/[\\\\/]/).pop().replace(/[\\x00-\\x1f\\x7f]/g,'').trim();\n  const ext=fileName.includes('.')?fileName.split('.').pop().toLowerCase():'';\n  if(!fileName||!allowed.includes(ext))continue;\n  out.push({json:{accountUid:cfg.accountUid,folderUid:cfg.folderUid,mailboxScope:cfg.mailboxScope,messageId,sourceAttachment:field,fileName},binary:{data:{...b,fileName}},pairedItem:{item:i}});\n }\n}\nreturn out;"
      }
    },
    {
      "id": "b613c6dc-9441-52d8-9e35-f563dd9b3ff5",
      "name": "Hash attachment bytes",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        720,
        400
      ],
      "parameters": {
        "action": "hash",
        "binaryData": true,
        "binaryPropertyName": "data",
        "type": "SHA256",
        "dataPropertyName": "payloadHash",
        "encoding": "hex"
      }
    },
    {
      "id": "54ec7af5-1323-5b28-b107-b34023730e8a",
      "name": "Build attachment receipt keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const attachments=$('Split and validate attachments').all();\nreturn $input.all().map((x,i)=>{\n if(!/^[a-f0-9]{64}$/.test(x.json.payloadHash||''))throw new Error('Missing attachment SHA-256.');\n if(x.json.payloadHash==='e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')throw new Error('Empty attachments cannot be archived.');\n const binary=attachments[i]?.binary;\n if(!binary?.data)throw new Error('The source attachment binary is unavailable; no upload was attempted.');\n const j=x.json;\n return {json:{...j,receiptKey:JSON.stringify(['archive-v1',j.accountUid,j.folderUid,j.mailboxScope,j.messageId,j.sourceAttachment,j.fileName,j.payloadHash]),sourceRef:JSON.stringify([j.mailboxScope,j.messageId,j.sourceAttachment])},binary,pairedItem:{item:i}};\n});"
      }
    },
    {
      "id": "f31381ef-b3bc-56d9-b93a-0bb7ad339c63",
      "name": "Process one item",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1020,
        760
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
