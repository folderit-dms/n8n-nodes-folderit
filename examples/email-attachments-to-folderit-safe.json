      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expected=$('Restore work item').item.json; const actual=$('Read uploaded document').item.json; const verifiedHash=$input.first().json.verifiedHash;\nif(!actual.uid || actual.name!==expected.fileName || actual.folderUid!==expected.folderUid || verifiedHash!==expected.payloadHash) throw new Error('Uploaded file readback/hash did not match. Keep the pending receipt and inspect the destination before retrying.');\nreturn [{json:{receiptRowId:expected.receiptRowId,targetUid:actual.uid},pairedItem:{item:0}}];"
      }
