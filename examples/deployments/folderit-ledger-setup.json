        }
      }
    },
    {
      "id": "83c80a58-f6fb-5631-b820-e8f84b83bf9a",
      "name": "Validate table schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const table=$input.first().json; const expected=[\"key\", \"state\", \"owner\", \"payloadHash\", \"targetUid\", \"sourceRef\"]; if(!table.id || !Array.isArray(table.columns) || expected.some(k=>!table.columns.some(c=>c.name===k && c.type==='string'))) throw new Error('Existing table has an incompatible schema. Choose a new table name; do not replace customer data.'); return [{json:table}];"
      }
    },
    {
      "id": "8bcb44f9-0ed2-534f-ad9b-e176cd280674",
      "name": "Find existing lock",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        960,
        400
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Create or reuse ledger').first().json.id }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "key",
              "condition": "eq",
              "keyValue": "__mutex__"
            }
          ]
        },
        "returnAll": false,
        "limit": 2
      },
      "alwaysOutputData": true
    },
    {
      "id": "ba190b8c-4ee0-5fdb-b530-74b6128c17ea",
      "name": "Check setup state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=$input.all().filter(x=>x.json.id!==undefined); if(rows.length>1) throw new Error('Duplicate mutex rows need manual reconciliation.'); if(rows.length===1 && rows[0].json.sourceRef!=='folderit-ledger/v1') throw new Error('Unexpected lock schema.'); return [{json:{exists:rows.length?'yes':'no',tableId:$('Create or reuse ledger').first().json.id}}];"
      }
    },
    {
      "id": "c228d768-9989-5079-aafe-f5af4b50b33a",
      "name": "Lock already exists?",
      "type": "n8n-nodes-base.if",
