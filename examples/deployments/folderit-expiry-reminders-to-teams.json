      }
    },
    {
      "id": "bd8376ea-7fb8-5708-873f-ef4046718be8",
      "name": "Read document expiry dates",
      "type": "n8n-nodes-folderit.folderit",
      "typeVersion": 1,
      "position": [
        720,
        400
      ],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "accountUid": "={{ $('Settings').first().json.accountUid }}",
        "fileUid": "={{ $json.uid }}",
        "authentication": "folderitApi",
