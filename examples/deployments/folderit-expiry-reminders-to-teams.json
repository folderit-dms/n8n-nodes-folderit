      "type": "n8n-nodes-folderit.folderit",
      "typeVersion": 1,
      "position": [
        480,
        400
      ],
      "parameters": {
        "resource": "file",
        "operation": "getAll",
        "accountUid": "={{ $('Settings').first().json.accountUid }}",
        "folderUid": "={{ $('Settings').first().json.folderUid }}",
