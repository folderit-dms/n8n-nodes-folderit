        240,
        400
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"accountUid\": \"YOUR_ACCOUNT_UID\",\n  \"folderUid\": \"YOUR_CERTIFICATE_FOLDER_UID\",\n  \"ledgerTableId\": \"YOUR_LEDGER_TABLE_ID\",\n  \"teamId\": \"YOUR_TEAM_ID\",\n  \"channelId\": \"YOUR_CHANNEL_ID\",\n  \"reminderDays\": \"30,7,1,0\",\n  \"overdueDays\": 7\n}",
        "options": {}
      }
    },
    {
      "id": "b3a8d8f6-012a-5ab6-9aef-387e24b3e3e6",
