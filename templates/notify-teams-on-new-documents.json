    {
      "id": "1ede5c28-8799-544c-aef0-aca98f6a9732",
      "name": "Read new document details",
      "type": "n8n-nodes-folderit.folderit",
      "typeVersion": 1,
      "position": [
        400,
        400
      ],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "accountUid": "={{ $('Settings').first().json.accountUid }}",
        "fileUid": "={{ $('New Folderit file').item.json.entityUid }}"
      }
    },
    {
      "id": "a4c08ab9-ae9c-5b77-aa55-1bc494961a15",
      "name": "Prepare arrival notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg=$('Settings').first().json;\nfor(const key of ['ledgerTableId','teamId','channelId'])if(!cfg[key]||cfg[key].startsWith('YOUR_'))throw new Error(`Replace ${key} in Settings.`);\nconst events=$('New Folderit file').all();const seen=new Set();const out=[];\nfor(const [i,item]of $input.all().entries()){\n const e=events[i]?.json;if(!e?.auditUid||e.entityUid!==item.json.uid)throw new Error('File details do not match the audit event.');\n if(seen.has(e.auditUid))continue;seen.add(e.auditUid);if(cfg.folderUid&&item.json.folderUid!==cfg.folderUid)continue;\n const name=String(item.json.name||'').replace(/[\\r\\n]/g,' ');\n out.push({json:{receiptKey:JSON.stringify(['teams-arrival-v1',cfg.accountUid,e.auditUid,cfg.teamId,cfg.channelId]),sourceRef:e.auditUid,notificationText:`New document in Folderit: ${name}\\nDocument UID: ${item.json.uid}\\nAudit UID: ${e.auditUid}`},pairedItem:{item:i}});\n}return out;"
      }
    },
